# Edit Sathi Environment Configuration Placeholder
# Core editing, rendering, and AI operate 100% on-device by default.
# Optional external or cloud AI service keys can be placed here if configured in the future.

# Optional AI / Cloud Transcription API Key (Disabled by default, core features do not require this)
OPTIONAL_AI_SERVICE_API_KEY=your_optional_api_key_here
OPTIONAL_AI_SERVICE_ENDPOINT=https://api.example.com/v1

# App Build Configuration
APP_ENV=development
ENABLE_DEBUG_LOGS=true
